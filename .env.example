# ── Supabase (필수) ──────────────────────────────────────────
# 대시보드 › Project Settings › API Keys 에서 복사하세요.
# 브라우저에 공개돼도 되는 키예요. 데이터는 RLS가 지켜요. (service_role / secret 키는 절대 넣지 마세요)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 새 형식(sb_publishable_...) 또는 기존 anon 키 중 하나
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Authentication › Sign In / Providers 에서 Google을 켠 뒤 true로 바꾸면 로그인 화면에 Google 버튼이 생겨요
NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH=false

# ── 선택 ────────────────────────────────────────────────────
# 비워 두면 키 없이 쓰는 Google 지도 임베드를 사용해요.
# Google Cloud에서 "Maps Embed API" 키를 발급해 넣으면 공식 Embed API로 바뀌어요.
# (공개 배포 시 HTTP 리퍼러 제한을 꼭 걸어 주세요)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 배포 주소 — 공유 링크 · OG 이미지 · sitemap의 절대 URL에 쓰여요 (기본값 http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# ── 항공권 캡처 인식 (Claude Vision) — 선택 ──────────────────────
# 서버 전용 비밀 키예요. 절대 NEXT_PUBLIC_을 붙이지 마세요 (붙이면 브라우저 번들에 그대로 들어가요).
# 비워 두면 /api/ticket-scan이 503(not_configured)을 돌려줘요.
ANTHROPIC_API_KEY=
# 하루 인식 횟수 제한 (기본값: 사용자 10 · 서비스 전체 30). 서버 메모리로 세요.
# 진짜 비용 상한은 Anthropic Console › Limits의 월 지출 한도로 걸어 두세요.
# TICKET_SCAN_USER_PER_DAY=10
# TICKET_SCAN_GLOBAL_PER_DAY=30
# 같은 키로 일정 화면의 'AI에게 일정 짜달라고 하기'(/api/plan)도 켜져요. 비워 두면 인기 순 자동 일정으로 대신 짜요.
# PLAN_USER_PER_DAY=10
# PLAN_GLOBAL_PER_DAY=50

# ── E2E 테스트 (Playwright) — 선택 ─────────────────────────────
# 기본은 로컬 Supabase(`npm run db:start`, Docker 필요)라서 아무것도 넣지 않아도 돼요.
# 값을 비워 두면 `supabase status`에서 로컬 주소 · 키를 읽어요. 앱 서버에는 주소와 공개 키만 넘어가요.
# 운영 프로젝트 보호: localhost가 아닌 주소는 E2E_ALLOW_REMOTE_SUPABASE=1일 때만 허용해요.
# (테스트 전용 원격 프로젝트를 쓸 때만, CI에서는 Secrets로 넣고 코드에 적지 마세요)
# E2E_SUPABASE_URL=
# E2E_SUPABASE_ANON_KEY=
# 테스트가 만든 계정(@e2e.tuddy.test)을 끝나고 지울 때만 써요. 앱에는 절대 넘기지 않아요.
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_ALLOW_REMOTE_SUPABASE=
# E2E_PORT=3100            # 테스트 서버 포트
# E2E_REUSE_SERVER=        # 1이면 이미 떠 있는 테스트 서버를 재사용 (기본은 매번 새로 빌드)
